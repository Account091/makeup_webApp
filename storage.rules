rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 1. Public Portfolio & Offer Banners (Public Read, Admin Write)
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.role == 'admin' || 
        request.auth.token.role == 'owner'
      );
    }
    match /offers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.role == 'admin' || 
        request.auth.token.role == 'owner'
      );
    }

    // 2. Customer Reference Photo Uploads (Strictly Private)
    match /customer_uploads/{bookingId}/{fileName} {
      // Allow creation for images under 10MB
      allow create: if request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      // Read access restricted to Admin or authenticated booking owner
      allow read: if request.auth != null && (
        request.auth.token.role == 'admin' || 
        request.auth.token.role == 'owner' ||
        resource.metadata.customerEmail == request.auth.token.email
      );
      allow delete: if request.auth != null && (
        request.auth.token.role == 'admin' || 
        request.auth.token.role == 'owner'
      );
    }
  }
}
